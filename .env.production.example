# ============================================================
#  WatchEarn - PRODUCTION environment (Vercel + Supabase)
# ============================================================
#  HOW TO USE THIS FILE
#  1. On your laptop, copy it to ".env" in a COPY of the project
#     (keep your local .env safe - rename it to .env.local.bak).
#  2. Fill in the values marked <...> from your Supabase project.
#  3. Run:  php artisan key:generate   (fills APP_KEY for you)
#  4. Run the migrations + seed against Supabase (see
#     docs/DEPLOY_VERCEL_SUPABASE.md), then paste the SAME values
#     into Vercel > Project > Settings > Environment Variables.
#
#  NEVER commit this file anywhere, and never send these values
#  in chat. They live only on your laptop and in Vercel.
# ============================================================

APP_NAME=WatchEarn
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app

# --- Supabase PostgreSQL (use the SESSION POOLER values) ---
DB_CONNECTION=pgsql
DB_HOST=<aws-0-REGION.pooler.supabase.com>
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-supabase-database-password>
DB_SSLMODE=require

# --- Admin account created by the seeder on first deploy ---
# Choose a STRONG password. It is only used once, at seed time.
ADMIN_EMAIL=admin@watchearn.local
ADMIN_PASSWORD=<choose-a-strong-admin-password>

# --- Serverless-safe drivers (already set in vercel.json too) ---
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# --- Email (REQUIRED for verification codes on the live site) ---
# Brevo free tier works well: verify your email as a sender in
# Brevo, then use its SMTP credentials below.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<your-brevo-login-email>
MAIL_PASSWORD=<your-brevo-smtp-key>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<your-verified-sender-email>
MAIL_FROM_NAME=WatchEarn
